{
  "name": "inkmesh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @inkmesh/web",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config e2e/screenshots.config.ts",
    "dev:server": "npm run dev -w @inkmesh/server",
    "dev:web": "npm run dev -w @inkmesh/web",
    "start": "node apps/server/dist/main.js",
    "bench": "tsx bench/run-all.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "20.19.43",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
